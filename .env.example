# Copy to .env and fill in your IBM Cloud API key locally.
IBM_QUANTUM_TOKEN=
# Optional IBM Quantum Compute instance CRN, preferred for accounts with multiple instances.
IBM_QUANTUM_INSTANCE=
# Optional backend name. Leave empty to choose an available backend.
IBM_QUANTUM_BACKEND=
# Optional ordered physical pair, central first and spectator second, e.g. 12,13.
IBM_QUANTUM_QUBITS=
